/* ============================================================
   MOSCATELLI — THRESHOLD VEIL V9
   ============================================================ */

:root {
  --bg-deep: #0d1117;
  --bg-charcoal: #121821;
  --mist-cool: rgba(78, 96, 118, 0.26);
  --mist-warm: rgba(78, 56, 45, 0.18);
  --mist-oxblood: rgba(113, 23, 29, 0.08);
  --veil-soft: rgba(255, 255, 255, 0.048);
  --veil-edge: rgba(255, 255, 255, 0.022);
  --text-primary: #f2ede5;
  --text-secondary: rgba(242, 237, 229, 0.74);
  --text-soft: rgba(242, 237, 229, 0.46);
  --shadow-soft: rgba(0, 0, 0, 0.22);
  --black-pitch: #000000;
  --transition-fast: 240ms ease;
  --transition-slow: 700ms cubic-bezier(0.22, 1, 0.36, 1);
}

/* ============================================================
   RESET
   ============================================================ */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background:
    radial-gradient(78rem 54rem at 18% 24%, rgba(86, 103, 126, 0.12), transparent 58%),
    radial-gradient(66rem 44rem at 82% 76%, rgba(78, 56, 45, 0.09), transparent 60%),
    linear-gradient(135deg, #0d1218 0%, #111720 42%, #1b1614 100%);
  color: var(--text-primary);
}

body {
  margin: 0;
  min-height: 100dvh;
  overflow: hidden;
  font-family: "Cinzel", serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* ============================================================
   THRESHOLD
   ============================================================ */

.threshold {
  position: relative;
  min-height: 100dvh;
  display: grid;
  place-items: center;
  isolation: isolate;
  overflow: hidden;
}

.threshold::before,
.threshold::after {
  content: "";
  position: absolute;
  inset: -10%;
  pointer-events: none;
}

.threshold::before {
  background:
    radial-gradient(50rem 32rem at 19% 30%, var(--mist-cool), transparent 58%),
    radial-gradient(44rem 30rem at 79% 73%, var(--mist-warm), transparent 62%),
    radial-gradient(36rem 22rem at 74% 82%, var(--mist-oxblood), transparent 65%),
    linear-gradient(125deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.012) 34%, rgba(255, 255, 255, 0.026) 72%, rgba(255, 255, 255, 0.016));
  filter: blur(44px) saturate(112%);
  opacity: 0.96;
  transform: scale(1.04);
  animation: veil-arrive 1400ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.threshold::after {
  inset: 0;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.032), rgba(255, 255, 255, 0.01) 22%, rgba(255, 255, 255, 0.014) 76%, rgba(255, 255, 255, 0.03)),
    radial-gradient(56rem 42rem at 50% 50%, rgba(255, 255, 255, 0.026), transparent 65%);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    inset 0 0 0 1px rgba(255, 255, 255, 0.022);
  opacity: 0.88;
  animation: veil-arrive 1300ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.threshold__blackout {
  position: fixed;
  inset: 0;
  background: var(--black-pitch);
  opacity: 0;
  z-index: 2;
  pointer-events: none;
  transition: opacity 2200ms cubic-bezier(0.22, 1, 0.36, 1);
}


.threshold__inner {
  position: relative;
  z-index: 3;
  display: grid;
  justify-items: center;
  gap: 1.38rem;
  padding: 2rem;
  text-align: center;
  transform: translateY(-1.4vh);
}

.threshold__wordmark {
  position: relative;
  z-index: 4;
  margin: 0;
  font-weight: 400;
  font-size: clamp(1.26rem, 2.8vw, 2.56rem);
  line-height: 1;
  letter-spacing: clamp(0.42em, 1.25vw, 0.78em);
  text-transform: uppercase;
  text-indent: 0.78em;
  color: var(--text-primary);
  text-shadow:
    0 1px 0 rgba(255, 255, 255, 0.045),
    0 18px 44px var(--shadow-soft);
  user-select: none;
  white-space: nowrap;
  opacity: 0;
  transform: translateY(12px);
  animation: wordmark-arrive 1400ms cubic-bezier(0.22, 1, 0.36, 1) 220ms forwards;
  transition: opacity 260ms ease;
}

.threshold__cta {
  appearance: none;
  background: none;
  border: 0;
  padding: 0;
  margin: 0;
  font: inherit;
  font-size: clamp(0.62rem, 0.95vw, 0.82rem);
  letter-spacing: 0.34em;
  text-transform: uppercase;
  color: var(--text-secondary);
  cursor: pointer;
  position: relative;
  z-index: 3;
  opacity: 0;
  transform: translateY(10px);
  animation: cta-arrive 1400ms cubic-bezier(0.22, 1, 0.36, 1) 1680ms forwards;
  transition:
    color var(--transition-fast),
    transform var(--transition-fast),
    opacity 1200ms ease,
    filter 1200ms ease;
}

.threshold__cta::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -0.58rem;
  width: 100%;
  height: 1px;
  background: rgba(242, 237, 229, 0.46);
  transform: translateX(-50%) scaleX(var(--cta-underline-scale, 0));
  transform-origin: center;
  opacity: var(--cta-underline-opacity, 0);
  transition:
    transform var(--transition-slow),
    opacity var(--transition-fast),
    background-color var(--transition-fast);
}

.threshold__cta:hover,
.threshold__cta:focus-visible {
  color: var(--text-primary);
  transform: translateY(-1px);
  outline: none;
}

.threshold__cta:hover::after,
.threshold__cta:focus-visible::after {
  --cta-underline-scale: 1;
  --cta-underline-opacity: 1;
  transform: translateX(-50%) scaleX(var(--cta-underline-scale, 1));
  opacity: var(--cta-underline-opacity, 1);
  background: rgba(242, 237, 229, 0.58);
}

.threshold__cta[data-skippable]::before {
  content: "tap again to skip";
  position: absolute;
  top: -2.2rem;
  left: 50%;
  transform: translateX(-50%);
  font-size: 0.5rem;
  letter-spacing: 0.2em;
  color: rgba(242, 237, 229, 0.3);
  white-space: nowrap;
  opacity: 0;
  animation: hint-arrive 500ms ease 450ms forwards;
}


.threshold__disclaimer {
  margin: 0;
  font-size: clamp(0.52rem, 0.7vw, 0.64rem);
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--text-soft);
  opacity: 0;
  transform: translateY(8px);
  filter: blur(3px);
  animation: disclaimer-arrive 1200ms cubic-bezier(0.22, 1, 0.36, 1) 980ms forwards;
  user-select: none;
  transition:
    opacity 1200ms ease,
    filter 1200ms ease;
}

.threshold__disclaimer--bottom {
  position: absolute;
  left: 50%;
  bottom: clamp(1.1rem, 2.2vh, 1.9rem);
  transform: translateX(-50%) translateY(8px);
  z-index: 3;
  width: max-content;
  max-width: calc(100vw - 2rem);
  text-align: center;
  pointer-events: none;
}

/* ============================================================
   PAGE TRANSITION
   ============================================================ */

.threshold__blackout {
  position: fixed;
  inset: 0;
  background: #000000;
  opacity: 0;
  z-index: 2;
  pointer-events: none;
}


/* ============================================================
   DESTINATION PLACEHOLDER
   ============================================================ */

.chapter-page {
  background: #000000;
  opacity: 1;
  transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1);
}

.chapter-page.page-enter {
  opacity: 0;
}

.page-blackout {
  min-height: 100dvh;
  background: #000000;
}

/* ============================================================
   ANIMATIONS
   ============================================================ */

@keyframes veil-arrive {
  from {
    opacity: 0;
    transform: scale(1.08);
  }
  to {
    opacity: 1;
    transform: scale(1.04);
  }
}

@keyframes wordmark-arrive {
  from {
    opacity: 0;
    transform: translateY(12px);
    filter: blur(5px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

@keyframes disclaimer-arrive {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(8px);
    filter: blur(3px);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    filter: blur(0);
  }
}

@keyframes hint-arrive {
  from { opacity: 0; transform: translateX(-50%) translateY(4px); }
  to { opacity: 1; transform: translateX(-50%) translateY(0); }
}

@keyframes cta-arrive {
  from {
    opacity: 0;
    transform: translateY(14px);
    filter: blur(6px);
  }
  55% {
    opacity: 0.38;
  }
  to {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 680px) {
  .threshold__inner {
    gap: 1.14rem;
    padding: 1.5rem;
    transform: translateY(-0.9vh);
  }


  .threshold__wordmark {
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    white-space: normal;
    line-height: 1.15;
  }

  .threshold__disclaimer {
    font-size: 0.5rem;
    letter-spacing: 0.2em;
  }

  .threshold__disclaimer--bottom {
    bottom: 1rem;
    max-width: calc(100vw - 1.5rem);
  }

  .threshold__cta {
    letter-spacing: 0.26em;
  }
}

/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  .threshold::before,
  .threshold::after,
  .threshold__wordmark,
  .threshold__disclaimer,
  .threshold__cta,
  .threshold__cta::after {
    animation: none !important;
    transition: none !important;
  }

  .threshold__wordmark,
  .threshold__disclaimer,
  .threshold__cta {
    opacity: 1;
    filter: none;
  }

  .threshold__wordmark,
  .threshold__cta {
    transform: none;
  }

  .threshold__disclaimer--bottom {
    transform: translateX(-50%);
  }

  .chapter-page {
    opacity: 1 !important;
  }
}


/* ============================================================
   PROJECT INDEX
   ============================================================ */

.project-index-page {
  background: #000000;
  overflow: hidden;
  color: var(--text-primary);
}

.project-index {
  position: relative;
  min-height: 100dvh;
  display: grid;
  grid-template-rows: auto 1fr auto;
  overflow: hidden;
  isolation: isolate;
  background: #000000;
}

.project-index__atmosphere {
  position: absolute;
  inset: 0;
  z-index: 0;
  opacity: 0;
  pointer-events: none;
  background:
    radial-gradient(68rem 40rem at 18% 24%, rgba(94, 111, 132, 0.16), transparent 58%),
    radial-gradient(60rem 38rem at 80% 74%, rgba(82, 59, 48, 0.14), transparent 60%),
    radial-gradient(34rem 20rem at 74% 82%, rgba(113, 23, 29, 0.07), transparent 66%),
    linear-gradient(135deg, #0f141a 0%, #131820 42%, #1b1614 100%);
  filter: blur(30px) saturate(110%);
  transform: scale(1.04);
  transition: opacity 2600ms cubic-bezier(0.22, 1, 0.36, 1);
}

.project-index__atmosphere.is-visible {
  opacity: 1;
}

.project-index__header,
.project-index__stage,
.project-index__footer {
  position: relative;
  z-index: 1;
}

.project-index__header {
  padding: clamp(0.84rem, 2.1vh, 1.4rem) clamp(1.1rem, 2.4vw, 2.4rem) 0;
  opacity: 0;
  transform: translateY(-18px) scaleX(0.92);
  transform-origin: top center;
  filter: blur(8px);
}

.project-index__header.is-visible {
  opacity: 1;
  transform: translateY(0) scaleX(1);
  filter: blur(0);
  transition:
    opacity 1100ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 1100ms cubic-bezier(0.22, 1, 0.36, 1),
    filter 1100ms cubic-bezier(0.22, 1, 0.36, 1);
}

.project-index__header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.7rem;
  min-height: 3.5rem;
  padding: 0 0 0.63rem;
  border-bottom: 1px solid rgba(242, 237, 229, 0.12);
}

.project-index__header-inner {
  position: relative;
}

.project-index__header-monogram-wrap {
  position: absolute;
  left: 50%;
  top: calc(50% - 0.12rem);
  transform: translate(-50%, -50%);
  display: grid;
  place-items: center;
  width: 5.8rem;
  height: 3rem;
  pointer-events: none;
  z-index: 2;
  opacity: 0;
  filter: blur(4px);
  overflow: visible;
  transition:
    opacity 1100ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 1100ms cubic-bezier(0.22, 1, 0.36, 1),
    filter 1100ms cubic-bezier(0.22, 1, 0.36, 1);
}

.project-index__header-monogram-wrap::before {
  content: none;
}

.project-index__header.is-visible .project-index__header-monogram-wrap {
  opacity: 1;
  transform: translate(-50%, -50%);
  filter: blur(0);
}

.project-index__header-monogram {
  position: relative;
  z-index: 1;
  width: 3.35rem;
  height: auto;
  display: block;
  opacity: 0.5;
  object-fit: contain;
  image-rendering: auto;
  backface-visibility: hidden;
  transform: translateY(-0.04rem) translateZ(0);
  filter: brightness(0) saturate(100%) invert(92%) sepia(8%) saturate(404%) hue-rotate(345deg) brightness(104%) contrast(89%);
}

.project-index__footer {
  display: grid;
  justify-items: center;
  gap: 0.48rem;
}

.project-index__footer-disclaimer {
  text-align: center;
  font-family: "Cinzel", serif;
  font-size: 0.52rem;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: rgba(242, 237, 229, 0.26);
}


.project-index__language-toggle {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  flex-wrap: wrap;
  justify-content: center;
  margin-left: 0;
  position: relative;
  z-index: 3;
}

.project-index__language {
  appearance: none;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 999px;
  padding: 0.42rem 0.8rem 0.45rem;
  font-family: "Cormorant Garamond", serif;
  font-size: 0.9rem;
  line-height: 1;
  color: rgba(242, 237, 229, 0.38);
  cursor: pointer;
  user-select: none;
  pointer-events: auto;
  transition: color 220ms ease, border-color 220ms ease, background 220ms ease, opacity 220ms ease;
}

.project-index__language:hover,
.project-index__language:focus-visible {
  color: rgba(242, 237, 229, 0.72);
  border-color: rgba(242, 237, 229, 0.1);
  background: rgba(255, 255, 255, 0.02);
  outline: none;
}

.project-index__language.is-active {
  color: rgba(242, 237, 229, 0.86);
  border-color: rgba(242, 237, 229, 0.16);
  background: rgba(255, 255, 255, 0.03);
}

.lang-fade-target {
  transition:
    opacity 280ms ease,
    filter 280ms ease;
}

.lang-fade-target.is-lang-out {
  opacity: 0;
  filter: blur(8px);
}

.lang-fade-target.is-lang-in {
  animation: moscatelliLangIn 620ms cubic-bezier(0.22, 1, 0.36, 1);
}


.project-index__header .project-index__detail-return.lang-fade-target {
  transition: opacity 220ms ease, filter 220ms ease, color 220ms ease !important;
}

.project-index__header .project-index__detail-return.lang-fade-target.is-lang-out {
  transform: translateY(-50%) !important;
}

.project-index__header .project-index__detail-return.lang-fade-target.is-lang-in {
  animation: moscatelliLangInHeaderStatic 620ms cubic-bezier(0.22, 1, 0.36, 1) !important;
}

@keyframes moscatelliLangInHeaderStatic {
  from {
    opacity: 0;
    filter: blur(10px);
    transform: translateY(-50%);
  }
  to {
    opacity: 1;
    filter: blur(0);
    transform: translateY(-50%);
  }
}

.lang-fade-target--radial {
  transition:
    opacity 180ms ease,
    filter 180ms ease;
}

.lang-fade-target--radial.is-lang-out-radial {
  opacity: 0;
  filter: blur(8px);
}

.lang-fade-target--radial.is-lang-in-radial {
  animation: moscatelliLangInRadial 520ms cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes moscatelliLangIn {
  from {
    opacity: 0;
    filter: blur(10px);
  }
  to {
    opacity: 1;
    filter: blur(0);
  }
}

@keyframes moscatelliLangInRadial {
  from {
    opacity: 0;
    filter: blur(10px);
  }
  to {
    opacity: 1;
    filter: blur(0);
  }
}

body.is-language-switching .project-index__radial-shell,
body.is-language-switching .project-index__radial-item,
body.is-language-switching .project-index__radial-label,
body.is-language-switching .project-index__radial-center {
  transition-property: opacity, filter, color, background, border-color, box-shadow;
}

body.is-language-switching .project-index__radial.is-expanded .project-index__radial-center {
  transition: color 240ms ease !important;
  transition-delay: 0ms !important;
}


body.is-language-switching .project-index__detail-nav-item {
  transition-property: color, opacity, filter, text-shadow !important;
}

body.is-language-switching .project-index__detail-nav-item.is-active {
  transform: scale(1.055) !important;
}

body.is-language-switching .project-index__detail-lede,
body.is-language-switching .project-index__detail-copy,
body.is-language-switching .project-index__header .project-index__detail-title,
body.is-language-switching .project-index__header .project-index__detail-kicker,
body.is-language-switching .project-index__header .project-index__detail-return {
  will-change: opacity, filter;
}

.project-index__stage {
  position: relative;
  isolation: isolate;
  display: grid;
  align-items: center;
  padding: clamp(2rem, 4vh, 3.6rem) clamp(1.1rem, 2.4vw, 2.4rem);
  overflow: hidden;
}

.project-index__cards {
  width: min(980px, 100%);
  margin: 0 auto;
  display: grid;
  gap: clamp(1rem, 2vh, 1.5rem);
}

.project-card {
  appearance: none;
  position: relative;
  width: 100%;
  display: grid;
  gap: 0.45rem;
  text-align: left;
  padding: clamp(1.25rem, 2.4vw, 1.9rem) clamp(1.2rem, 2.6vw, 2.1rem);
  border: 1px solid rgba(242, 237, 229, 0.16);
  border-radius: 6px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.018), rgba(255, 255, 255, 0.012));
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.04),
    0 18px 48px rgba(0, 0, 0, 0.18);
  color: var(--text-primary);
  cursor: pointer;
  opacity: 0;
  transform: translateY(22px) scale(0.985);
  filter: blur(8px);
}

.project-card.is-visible {
  opacity: 1;
  transform: translateY(0) scale(1);
  filter: blur(0);
  transition:
    opacity 1050ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 1050ms cubic-bezier(0.22, 1, 0.36, 1),
    filter 1050ms cubic-bezier(0.22, 1, 0.36, 1),
    border-color 260ms ease,
    background 260ms ease,
    box-shadow 260ms ease;
}

.project-card::before {
  content: "";
  position: absolute;
  right: 1.8rem;
  top: 50%;
  width: 3.2rem;
  height: 3.2rem;
  border-radius: 50%;
  border: 1px solid rgba(242, 237, 229, 0.13);
  box-shadow: 0 0 0 0.55rem rgba(242, 237, 229, 0.032);
  transform: translateY(-50%) scale(0.55);
  opacity: 0;
  pointer-events: none;
  transition: opacity 420ms ease, transform 640ms cubic-bezier(0.22, 1, 0.36, 1);
}

.project-card:hover::before,
.project-card:focus-visible::before {
  opacity: 1;
  transform: translateY(-50%) scale(1);
}

.project-card:hover,
.project-card:focus-visible {
  outline: none;
  border-color: rgba(242, 237, 229, 0.25);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.026), rgba(255, 255, 255, 0.016));
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.06),
    0 20px 60px rgba(0, 0, 0, 0.26);
}

.project-card__kicker {
  font-family: "Cinzel", serif;
  font-size: 0.68rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: rgba(242, 237, 229, 0.44);
  transition: color 260ms ease, letter-spacing 400ms cubic-bezier(0.22, 1, 0.36, 1);
}

.project-card:hover .project-card__kicker {
  color: rgba(242, 237, 229, 0.62);
  letter-spacing: 0.36em;
}

.project-card__title {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1.23rem, 1.82vw, 1.75rem);
  line-height: 1;
  color: rgba(242, 237, 229, 0.96);
}

.project-card__body {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1rem, 1.2vw, 1.12rem);
  line-height: 1.5;
  color: rgba(242, 237, 229, 0.62);
  max-width: 46rem;
}

.project-index__footer {
  padding: 0 clamp(1.1rem, 2.4vw, 2.4rem) clamp(1rem, 2vh, 1.4rem);
  opacity: 0;
  filter: blur(8px);
}

.project-index__footer.is-visible {
  opacity: 1;
  filter: blur(0);
  transition:
    opacity 1200ms cubic-bezier(0.22, 1, 0.36, 1),
    filter 1200ms cubic-bezier(0.22, 1, 0.36, 1);
}

.project-index__footer-wordmark {
  text-align: center;
  font-family: "Cinzel", serif;
  font-size: 0.72rem;
  letter-spacing: 0.48em;
  text-indent: 0.48em;
  text-transform: uppercase;
  color: rgba(242, 237, 229, 0.42);
}


@media (max-width: 1180px) {
  .project-index__detail-content {
    left: clamp(3rem, 4.5vw, 4.8rem);
    top: clamp(13rem, 20vh, 15rem);
    width: min(34rem, 44vw);
    max-width: 34rem;
  }

  .project-index__detail-lede {
    font-size: clamp(1.4rem, 1.75vw, 1.96rem);
    max-width: 12ch;
  }

  .project-index__detail-copy {
    max-width: 28rem;
  }
}

@media (max-width: 820px) {
  .project-index__detail-content {
    left: clamp(2rem, 6vw, 2.8rem);
    top: clamp(10.8rem, 18vh, 12.6rem);
    width: min(28rem, calc(100vw - 6rem));
    max-width: 28rem;
    row-gap: 1.5rem;
  }

  .project-index__detail-lede {
    font-size: clamp(1.3rem, 4.9vw, 1.75rem);
    max-width: 13ch;
  }

  .project-index__detail-copy {
    max-width: 24rem;
  }

  .project-index__detail-copy p {
    max-width: 32ch;
  }
}
@media (max-width: 820px) {
  .project-index__header-inner {
    flex-direction: column;
    align-items: stretch;
    gap: 0.67rem;
    padding-top: 0.18rem;
  }

  .project-index__header-monogram-wrap {
    top: 0.74rem;
    transform: translateX(-50%);
    width: 100%;
    height: 1.54rem;
  }

  .project-index__header-monogram {
    width: 1.72rem;
  }

  .project-index__language-toggle {
    justify-content: center;
    margin-left: 0;
    padding-top: 0.1rem;
  }

  .project-card {
    border-radius: 5px;
  }
}

@media (max-width: 560px) {
  .project-index__stage {
    padding-top: 1.6rem;
    padding-bottom: 1.6rem;
  }

  .project-index__cards {
    gap: 0.9rem;
  }

  .project-card {
    padding: 1.1rem 1rem 1.2rem;
    border-radius: 4px;
  }

  .project-index__language {
    padding-inline: 0.62rem;
    font-size: 0.92rem;
  }

  .project-index__footer-wordmark {
    letter-spacing: 0.34em;
    text-indent: 0.34em;
  }
}


.project-index__stage {
  position: relative;
}

.project-index__cards.is-menu-open .project-card {
  pointer-events: none;
}

.project-card.is-withdrawing {
  opacity: 0;
  filter: blur(10px);
  transform: translateY(0) scale(0.975);
  transition:
    opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
    filter 700ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
}

.project-card.is-origin-hidden {
  opacity: 0 !important;
  pointer-events: none;
}

.project-index__radial {
  --radial-size: clamp(4.85rem, 6vw, 5.45rem);
  --orbit-offset: clamp(11.6rem, 16.2vw, 13.75rem);
  --orbit-north: calc(var(--orbit-offset) * 0.98);
  --orbit-east: calc(var(--orbit-offset) * 1.06);
  --orbit-south: calc(var(--orbit-offset) * 1.08);
  --orbit-west: calc(var(--orbit-offset) * 1.02);
  --shell-x: 0px;
  --shell-y: 0px;
  --shell-width: 0px;
  --shell-height: 0px;
  --shell-radius: 6px;
  position: absolute;
  inset: 0;
  z-index: 4;
  pointer-events: none;
}

.project-index__radial.is-active {
  pointer-events: auto;
}

.project-index__radial-label {
  position: absolute;
  left: 50%;
  top: calc(50% - var(--orbit-north) - 3.35rem);
  transform: translate(-50%, 14px);
  font-family: "Cinzel", serif;
  font-size: 0.63rem;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: rgba(242, 237, 229, 0.28);
  opacity: 0;
  filter: blur(9px);
  transition:
    opacity 920ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 920ms cubic-bezier(0.22, 1, 0.36, 1),
    filter 920ms cubic-bezier(0.22, 1, 0.36, 1);
}

.project-index__radial.is-expanded .project-index__radial-label {
  opacity: 1;
  transform: translate(-50%, 0);
  filter: blur(0);
  transition-delay: 240ms;
}

.project-index__radial-shell {
  position: absolute;
  left: 0;
  top: 0;
  width: var(--shell-width);
  height: var(--shell-height);
  overflow: visible;
  transform: translate(var(--shell-x), var(--shell-y));
  border-radius: var(--shell-radius);
  border: 1px solid rgba(242, 237, 229, 0);
  background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0), rgba(255,255,255,0) 70%, rgba(255,255,255,0) 100%);
  box-shadow: none;
  backdrop-filter: blur(8px);
  opacity: 0;
  transition:
    width 1280ms cubic-bezier(0.16, 1, 0.3, 1),
    height 1280ms cubic-bezier(0.16, 1, 0.3, 1),
    transform 1280ms cubic-bezier(0.16, 1, 0.3, 1),
    border-radius 1280ms cubic-bezier(0.16, 1, 0.3, 1),
    opacity 240ms ease,
    box-shadow 820ms ease,
    background 820ms ease,
    border-color 820ms ease;
}

.project-index__radial.is-active .project-index__radial-shell {
  opacity: 1;
}

.project-index__radial.is-expanded .project-index__radial-shell {
  border-color: rgba(242, 237, 229, 0.08);
  background: radial-gradient(circle at 50% 42%, rgba(255,255,255,0.016), rgba(255,255,255,0.008) 46%, rgba(255,255,255,0) 74%);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.025),
    0 0 0 1px rgba(242,237,229,0.02),
    0 22px 48px rgba(0, 0, 0, 0.11);
}

.project-index__radial.is-expanded .project-index__radial-shell:hover,
.project-index__radial.is-expanded .project-index__radial-shell:focus-within {
  border-color: rgba(242, 237, 229, 0.12);
  background: radial-gradient(circle at 50% 42%, rgba(255,255,255,0.02), rgba(255,255,255,0.009) 48%, rgba(255,255,255,0) 76%);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.032),
    0 0 0 1px rgba(242,237,229,0.026),
    0 24px 52px rgba(0, 0, 0, 0.14),
    0 0 34px rgba(193, 176, 150, 0.03);
}

.project-index__radial-center {
  position: absolute;
  inset: 0;
  z-index: 6;
  appearance: none;
  border: 0;
  border-radius: inherit;
  background: transparent;
  color: rgba(242, 237, 229, 0.84);
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(0.88rem, 1.08vw, 1.02rem);
  font-style: italic;
  letter-spacing: 0.08em;
  cursor: pointer;
  opacity: 0;
  transform: scale(0.965);
  transition:
    opacity 480ms ease,
    transform 760ms cubic-bezier(0.22, 1, 0.36, 1),
    color 240ms ease;
}

.project-index__radial.is-expanded .project-index__radial-center {
  opacity: 1;
  transform: scale(1);
  transition-delay: 260ms;
}

.project-index__radial-center::before,
.project-index__radial-center::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  opacity: 0;
  transition:
    opacity 260ms ease,
    transform 620ms cubic-bezier(0.22, 1, 0.36, 1),
    border-color 260ms ease,
    box-shadow 260ms ease;
}

.project-index__radial-center::before {
  inset: -0.14rem;
  border: 1px solid rgba(242, 237, 229, 0.12);
  box-shadow: 0 0 0 1px rgba(242,237,229,0.014), 0 0 18px rgba(193,176,150,0.032);
  transform: scale(0.95);
}

.project-index__radial-center::after {
  inset: -0.48rem;
  border: 1px solid rgba(242, 237, 229, 0.04);
  box-shadow: 0 0 24px rgba(242,237,229,0.018);
  transform: scale(0.9);
}

.project-index__radial-center:hover,
.project-index__radial-center:focus-visible {
  outline: none;
  color: rgba(242, 237, 229, 0.96);
}

.project-index__radial-center:hover::before,
.project-index__radial-center:focus-visible::before {
  opacity: 0.84;
  transform: scale(1);
}

.project-index__radial-center:hover::after,
.project-index__radial-center:focus-visible::after {
  opacity: 0.34;
  transform: scale(1.02);
}

.project-index__radial-orbit {
  position: absolute;
  inset: 0;
  overflow: visible;
  z-index: 3;
  pointer-events: none;
}

.project-index__radial-item {
  position: absolute;
  z-index: 4;
  pointer-events: auto;
  left: 50%;
  top: 50%;
  min-width: 4.7rem;
  width: max-content;
  min-height: 1.6rem;
  appearance: none;
  border: 0;
  border-radius: 999px;
  background: transparent;
  box-shadow: none;
  color: rgba(242, 237, 229, 0.78);
  font-family: "Cormorant Garamond", serif;
  font-size: 0.92rem;
  line-height: 1.1;
  letter-spacing: 0.02em;
  padding: 0.22rem 0.78rem;
  cursor: pointer;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.62);
  transform-origin: center;
  filter: blur(10px);
  transition:
    transform 980ms cubic-bezier(0.16, 1, 0.3, 1),
    opacity 520ms ease,
    filter 980ms cubic-bezier(0.16, 1, 0.3, 1),
    color 240ms ease;
}

.project-index__radial-item::before,
.project-index__radial-item::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  opacity: 0;
  transition:
    opacity 260ms ease,
    transform 640ms cubic-bezier(0.22, 1, 0.36, 1),
    border-color 260ms ease,
    box-shadow 260ms ease,
    background 260ms ease;
}

.project-index__radial-item::before {
  inset: -0.18rem;
  border: 1px solid rgba(242, 237, 229, 0.11);
  background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.026), rgba(255,255,255,0.006) 60%, rgba(255,255,255,0) 100%);
  box-shadow: 0 0 0 1px rgba(242, 237, 229, 0.012), 0 0 20px rgba(180, 162, 135, 0.03);
  transform: scale(0.93);
}

.project-index__radial-item::after {
  inset: -0.52rem;
  border: 1px solid rgba(242, 237, 229, 0.032);
  box-shadow: 0 0 22px rgba(242, 237, 229, 0.016);
  transform: scale(0.88);
}

.project-index__radial.is-expanded .project-index__radial-item {
  opacity: 1;
  filter: blur(0);
}

.project-index__radial.is-expanded .project-index__radial-item--north {
  transform: translate(-50%, calc(-50% - var(--orbit-north))) scale(1);
  transition-delay: 40ms;
}
.project-index__radial.is-expanded .project-index__radial-item--east {
  transform: translate(calc(-50% + var(--orbit-east)), calc(-50% + 0.08rem)) scale(1);
  transition-delay: 120ms;
}
.project-index__radial.is-expanded .project-index__radial-item--south {
  transform: translate(calc(-50% + 0.1rem), calc(-50% + var(--orbit-south))) scale(1);
  transition-delay: 210ms;
}
.project-index__radial.is-expanded .project-index__radial-item--west {
  transform: translate(calc(-50% - var(--orbit-west)), calc(-50% - 0.04rem)) scale(1);
  transition-delay: 300ms;
}
.project-index__radial.is-expanded .project-index__radial-item--northwest {
  transform: translate(calc(-50% - (var(--orbit-west) * 0.82)), calc(-50% - (var(--orbit-north) * 0.72))) scale(1);
  transition-delay: 380ms;
}


.project-index__radial.is-closing .project-index__radial-label,
.project-index__radial.is-closing .project-index__radial-center,
.project-index__radial.is-closing .project-index__radial-item {
  opacity: 0 !important;
  filter: blur(8px);
  transition-duration: 180ms, 180ms, 180ms, 180ms;
  transition-delay: 0ms !important;
}

.project-index__radial.is-closing .project-index__radial-shell {
  opacity: 0;
  border-color: rgba(242, 237, 229, 0.01);
  background: transparent;
  box-shadow: none;
  backdrop-filter: blur(0);
  transition:
    width 760ms cubic-bezier(0.22, 1, 0.36, 1),
    height 760ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 760ms cubic-bezier(0.22, 1, 0.36, 1),
    border-radius 760ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 180ms ease,
    box-shadow 180ms ease,
    background 180ms ease,
    border-color 180ms ease,
    backdrop-filter 180ms ease;
}

.project-index__radial-item:hover,
.project-index__radial-item:focus-visible {
  outline: none;
  color: rgba(242, 237, 229, 0.95);
}

.project-index__radial-item:hover::before,
.project-index__radial-item:focus-visible::before {
  opacity: 0.84;
  border-color: rgba(242, 237, 229, 0.18);
  background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.044), rgba(255,255,255,0.012) 58%, rgba(255,255,255,0) 100%);
  box-shadow: 0 0 0 1px rgba(242, 237, 229, 0.02), 0 0 28px rgba(193, 176, 150, 0.055);
  transform: scale(1);
}

.project-index__radial-item:hover::after,
.project-index__radial-item:focus-visible::after {
  opacity: 0.28;
  border-color: rgba(242, 237, 229, 0.06);
  box-shadow: 0 0 30px rgba(242, 237, 229, 0.026);
  transform: scale(1.01);
}
@media (max-width: 820px) {
  .project-index__radial {
    --radial-size: 4.7rem;
    --orbit-offset: 9.6rem;
  }

  .project-index__radial-label {
    top: calc(50% - var(--orbit-north) - 2.7rem);
    font-size: 0.58rem;
  }

  .project-index__radial-item {
    font-size: 0.86rem;
    min-width: 4.3rem;
  }
}

@media (max-width: 560px) {
  .project-index__radial {
    --radial-size: 4.3rem;
    --orbit-offset: 7.4rem;
  }

  .project-index__radial-label {
    top: calc(50% - var(--orbit-north) - 2.25rem);
    font-size: 0.54rem;
    letter-spacing: 0.18em;
  }

  .project-index__radial-item {
    min-width: 3.75rem;
    font-size: 0.72rem;
    padding: 0.2rem 0.4rem;
  }

  .project-index__radial-center {
    font-size: 0.82rem;
  }
}


/* ============================================================
   FIRST SECTION DETAIL TRANSITION
   ============================================================ */

body.is-detail-open .project-index__radial,
body.is-detail-returning-to-index .project-index__radial {
  opacity: 0;
  filter: blur(10px);
  pointer-events: none;
  transition: opacity 520ms ease, filter 520ms ease;
}

.project-index__detail {
  position: absolute;
  inset: 0;
  z-index: 7;
  pointer-events: none;
  opacity: 0;
}

.project-index__detail.is-active {
  pointer-events: auto;
  opacity: 1;
}

.project-index__detail-return,
.project-index__detail-title-panel,
.project-index__detail-nav {
  position: absolute;
  transition:
    opacity 720ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 980ms cubic-bezier(0.16, 1, 0.3, 1),
    filter 720ms cubic-bezier(0.22, 1, 0.36, 1);
}

.project-index__detail-return,
.project-index__detail-title-panel,
.project-index__detail-nav {
  position: absolute;
  transition:
    opacity 720ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 980ms cubic-bezier(0.16, 1, 0.3, 1),
    filter 720ms cubic-bezier(0.22, 1, 0.36, 1);
}

.project-index__detail-return {
  appearance: none;
  right: 0;
  top: 50%;
  border: 0;
  background: transparent;
  color: rgba(242, 237, 229, 0.58);
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(0.98rem, 1.2vw, 1.16rem);
  letter-spacing: 0.045em;
  cursor: pointer;
  opacity: 0;
  transform: translateY(calc(-50% - 8px));
  filter: blur(8px);
  z-index: 3;
}

.project-index__detail-return:hover,
.project-index__detail-return:focus-visible {
  outline: none;
  color: rgba(242, 237, 229, 0.9);
}

.project-index__detail-title-panel {
  left: 0;
  top: 50%;
  width: min(26rem, 38vw);
  min-height: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  transform-origin: top left;
  opacity: 0;
  filter: blur(12px);
  z-index: 3;
}

.project-index__detail-kicker {
  font-size: 0.52rem;
  letter-spacing: 0.34em;
  text-transform: uppercase;
  color: rgba(242, 237, 229, 0.24);
  margin-bottom: 0.4rem;
}

.project-index__detail-title {
  margin: 0;
  font-family: "Cormorant Garamond", serif;
  font-weight: 300;
  font-size: clamp(1.33rem, 2.24vw, 2.17rem);
  line-height: 0.9;
  color: rgba(242, 237, 229, 0.94);
}


.project-index__detail-content {
  position: absolute;
  left: clamp(3.6rem, 4.2vw, 5rem);
  top: clamp(1.45rem, 2.2vh, 2.15rem);
  width: calc(100vw - clamp(7rem, 7.5vw, 9rem) - clamp(15rem, 16vw, 19rem));
  max-width: none;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  grid-template-areas:
    "lede"
    "copy";
  row-gap: clamp(0.95rem, 1.5vh, 1.3rem);
  align-items: start;
  opacity: 0;
  filter: blur(12px);
  transform: translateY(12px);
  transition:
    opacity 760ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 980ms cubic-bezier(0.16, 1, 0.3, 1),
    filter 760ms cubic-bezier(0.22, 1, 0.36, 1);
}

.project-index__detail-lede {
  grid-area: lede;
  margin: 0;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(2.21rem, 3.22vw, 3.57rem);
  line-height: 1.02;
  letter-spacing: -0.02em;
  color: rgba(242, 237, 229, 0.95);
  width: 100%;
  max-width: none;
  text-wrap: pretty;
}

.project-index__detail-copy {
  grid-area: copy;
  display: block;
  width: 100%;
  max-width: 78rem;
  padding-top: 0.1rem;
}

.project-index__detail-copy p {
  margin: 0 0 1.15rem;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1.16rem, 1.15vw, 1.34rem);
  line-height: 1.72;
  color: rgba(242, 237, 229, 0.72);
  max-width: 34rem;
}

.project-index__detail-nav {
  right: clamp(0.25rem, 1vw, 0.9rem);
  top: 50%;
  width: min(9.5rem, 12vw);
  display: grid;
  justify-items: end;
  gap: clamp(0.95rem, 1.7vh, 1.35rem);
  transform: translate(18px, -50%);
  opacity: 0;
  filter: blur(10px);
}

.project-index__detail-nav-item {
  appearance: none;
  position: relative;
  min-height: 0;
  padding: 0 1rem 0 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  text-align: right;
  color: rgba(242, 237, 229, 0.46);
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(0.96rem, 1.18vw, 1.22rem);
  line-height: 1;
  cursor: pointer;
  transform-origin: right center;
  transition: color 240ms ease, transform 520ms cubic-bezier(0.22,1,0.36,1), opacity 320ms ease, text-shadow 240ms ease;
}

.project-index__detail-nav-item::before {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  width: 0.38rem;
  height: 0.38rem;
  border-radius: 50%;
  border: 1px solid rgba(242, 237, 229, 0.12);
  background: rgba(242, 237, 229, 0.05);
  box-shadow: 0 0 0 0 rgba(242,237,229,0), 0 0 0.65rem rgba(242, 237, 229, 0.02);
  transform: translateY(-50%);
  transition: border-color 240ms ease, background 240ms ease, box-shadow 320ms ease, transform 320ms cubic-bezier(0.22,1,0.36,1);
}


.project-index__detail-nav-item:hover,
.project-index__detail-nav-item:focus-visible {
  outline: none;
  color: rgba(242, 237, 229, 0.94);
  text-shadow: 0 0 1rem rgba(242, 237, 229, 0.04);
}

.project-index__detail-nav-item:hover::before,
.project-index__detail-nav-item:focus-visible::before {
  border-color: rgba(242, 237, 229, 0.22);
  background: rgba(242, 237, 229, 0.11);
  box-shadow: 0 0 0 0.22rem rgba(242,237,229,0.03), 0 0 0.8rem rgba(191, 173, 146, 0.06);
  transform: translateY(-50%) scale(1.08);
}

.project-index__detail-nav-item.is-active {
  color: rgba(242, 237, 229, 0.94);
  opacity: 1;
  transform: scale(1.055);
  text-shadow: 0 0 0.9rem rgba(242, 237, 229, 0.035);
}

.project-index__detail-nav-item.is-active::before {
  border-color: rgba(242, 237, 229, 0.2);
  background: rgba(242, 237, 229, 0.1);
  box-shadow: 0 0 0 0.18rem rgba(242,237,229,0.026), 0 0 0.7rem rgba(191, 173, 146, 0.05);
  transform: translateY(-50%) scale(1.05);
}

.project-index__detail.is-ready .project-index__detail-return,
.project-index__detail.is-ready .project-index__detail-nav,
.project-index__detail.is-ready .project-index__detail-title-panel,
.project-index__detail.is-ready .project-index__detail-content {
  opacity: 1;
  filter: blur(0);
  transform: none;
}

.project-index__detail.is-switching .project-index__detail-title,
.project-index__detail.is-switching .project-index__detail-kicker,
.project-index__detail.is-switching .project-index__detail-lede,
.project-index__detail.is-switching .project-index__detail-copy {
  animation: moscatelliDetailSwap 420ms cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes moscatelliDetailSwap {
  0% { opacity: 1; filter: blur(0); transform: translateY(0); }
  45% { opacity: 0; filter: blur(8px); transform: translateY(6px); }
  100% { opacity: 1; filter: blur(0); transform: translateY(0); }
}
@keyframes moscatelliHeaderDetailSwapOut {
  from { opacity: 1; filter: blur(0); transform: translateY(0); }
  to { opacity: 0; filter: blur(10px); transform: translateY(8px); }
}

@keyframes moscatelliHeaderDetailSwapIn {
  from { opacity: 0; filter: blur(10px); transform: translateY(-8px); }
  to { opacity: 1; filter: blur(0); transform: translateY(0); }
}

body.is-detail-switching .project-index__header .project-index__detail-title,
body.is-detail-switching .project-index__header .project-index__detail-kicker {
  animation: moscatelliHeaderDetailSwapOut 170ms cubic-bezier(0.55, 0, 0.2, 1) forwards;
}

body.is-detail-switching.is-detail-switching-in .project-index__header .project-index__detail-title,
body.is-detail-switching.is-detail-switching-in .project-index__header .project-index__detail-kicker {
  animation: moscatelliHeaderDetailSwapIn 380ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}


body.is-detail-switching.is-detail-switching-in .project-index__detail .project-index__detail-lede,
body.is-detail-switching.is-detail-switching-in .project-index__detail .project-index__detail-copy {
  animation: moscatelliHeaderDetailSwapIn 380ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@media (max-width: 960px) {
  .project-index__detail-title-panel { width: min(22rem, 42vw); }
  .project-index__detail-title { font-size: clamp(1.19rem, 1.96vw, 1.75rem); }
  .project-index__detail-nav { right: clamp(0.2rem, 1.2vw, 0.8rem); width: min(8.8rem, 17vw); }
}


@media (max-width: 1180px) {
  .project-index__detail-content {
    left: clamp(2.8rem, 4vw, 4.2rem);
    top: clamp(5.2rem, 7vh, 6.2rem);
    width: calc(100vw - clamp(6rem, 8vw, 8rem) - clamp(13rem, 16vw, 15rem));
    row-gap: 1.5rem;
  }

  .project-index__detail-lede {
    max-width: none;
    font-size: clamp(1.5rem, 2.1vw, 2.1rem);
  }

  .project-index__detail-copy {
    width: 100%;
  }
}

@media (max-width: 720px) {
  .project-index__detail-title-panel {
    left: 1rem;
    right: 6.2rem;
    width: auto;
    top: 1.35rem;
  }
  .project-index__detail-title { font-size: clamp(1.47rem, 5.6vw, 2.1rem); }
  .project-index__detail-content {
    left: 1rem;
    right: 6.4rem;
    width: auto;
    top: clamp(8rem, 18vh, 9.4rem);
  }
  .project-index__detail-return {
    top: 1.15rem;
    right: 1rem;
    bottom: auto;
  }
  .project-index__detail-nav {
    top: 52%;
    right: 1rem;
    width: min(11.5rem, 40vw);
    gap: 1.25rem;
    transform: translateX(14px);
  }
  .project-index__detail-nav-item {
    font-size: 1.35rem;
    padding-left: 1.6rem;
  }
  .project-index__detail-nav-item::before {
    width: 0.62rem;
    height: 0.62rem;
  }
}


/* ============================================================
   DETAIL IN HEADER REFINEMENT
   ============================================================ */

.project-index__header .project-index__detail-title-panel,
.project-index__header .project-index__detail-return {
  position: absolute;
  top: 50%;
  z-index: 3;
  opacity: 0;
  pointer-events: none;
}

.project-index__header .project-index__detail-title-panel {
  left: 0;
  width: min(16rem, 26vw);
  transform: translateY(calc(-50% + 8px));
  filter: blur(10px);
}

.project-index__header .project-index__detail-kicker {
  font-size: 0.46rem;
  letter-spacing: 0.32em;
  margin-bottom: 0.2rem;
  color: rgba(242, 237, 229, 0.24);
}

.project-index__header .project-index__detail-title {
  font-size: clamp(0.91rem, 1.4vw, 1.3rem);
  line-height: 0.92;
  color: rgba(242, 237, 229, 0.9);
}

.project-index__header .project-index__detail-return {
  right: 0;
  top: 50%;
  transform: translateY(calc(-50% + 8px));
  filter: blur(10px);
  font-size: clamp(0.88rem, 1vw, 1.04rem);
  color: rgba(242, 237, 229, 0.6);
  letter-spacing: 0.04em;
  background: transparent;
  border: 0;
}

.project-index__detail.is-active ~ .project-index__header .project-index__detail-title-panel,
.project-index__detail.is-active ~ .project-index__header .project-index__detail-return,
body.is-detail-open .project-index__header .project-index__detail-title-panel,
body.is-detail-open .project-index__header .project-index__detail-return {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(-50%);
  filter: blur(0);
}

body.is-detail-open .project-index__header .project-index__detail-return:hover,
body.is-detail-open .project-index__header .project-index__detail-return:focus-visible {
  color: rgba(242, 237, 229, 0.92);
  outline: none;
}

body.is-detail-open .project-index__header {
  z-index: 9;
}

/* right-side detail nav behaviour */
.project-index__detail-nav {
  right: clamp(0.15rem, 0.7vw, 0.6rem);
  width: min(8.8rem, 11vw);
  gap: clamp(0.82rem, 1.55vh, 1.2rem);
}

.project-index__detail-nav-item {
  color: rgba(242, 237, 229, 0.42);
  transition: color 620ms cubic-bezier(0.22,1,0.36,1), opacity 620ms cubic-bezier(0.22,1,0.36,1), text-shadow 620ms cubic-bezier(0.22,1,0.36,1), transform 620ms cubic-bezier(0.22,1,0.36,1);
}

.project-index__detail-nav-item::before {
  transition: border-color 620ms cubic-bezier(0.22,1,0.36,1), background 620ms cubic-bezier(0.22,1,0.36,1), box-shadow 620ms cubic-bezier(0.22,1,0.36,1), transform 620ms cubic-bezier(0.22,1,0.36,1), opacity 620ms cubic-bezier(0.22,1,0.36,1);
}

.project-index__detail-nav-item:hover,
.project-index__detail-nav-item:focus-visible {
  color: rgba(242, 237, 229, 0.78);
  opacity: 1;
  text-shadow: 0 0 0.9rem rgba(242, 237, 229, 0.03);
}

.project-index__detail-nav-item:hover::before,
.project-index__detail-nav-item:focus-visible::before {
  border-color: rgba(242, 237, 229, 0.16);
  background: rgba(242, 237, 229, 0.08);
  box-shadow: 0 0 0 0.16rem rgba(242,237,229,0.02), 0 0 0.65rem rgba(191, 173, 146, 0.04);
  transform: translateY(-50%);
}

.project-index__detail-nav-item.is-active {
  color: rgba(242, 237, 229, 0.96);
  opacity: 1;
  transform: scale(1.035);
  text-shadow: 0 0 0.8rem rgba(242, 237, 229, 0.03);
}

.project-index__detail-nav-item.is-active::before {
  border-color: rgba(242, 237, 229, 0.18);
  background: rgba(242, 237, 229, 0.095);
  box-shadow: 0 0 0 0.16rem rgba(242,237,229,0.022), 0 0 0.68rem rgba(191, 173, 146, 0.04);
  transform: translateY(-50%) scale(1.03);
}

.project-index__radial-item.is-hidden,
.project-index__detail-nav-item.is-hidden {
  display: none !important;
}


@media (max-width: 1180px) {
  .project-index__detail-content {
    left: clamp(2.8rem, 4vw, 4.2rem);
    top: clamp(5.2rem, 7vh, 6.2rem);
    width: calc(100vw - clamp(6rem, 8vw, 8rem) - clamp(13rem, 16vw, 15rem));
    row-gap: 1.5rem;
  }

  .project-index__detail-lede {
    max-width: none;
    font-size: clamp(1.5rem, 2.1vw, 2.1rem);
  }

  .project-index__detail-copy {
    width: 100%;
  }
}

@media (max-width: 720px) {
  .project-index__header .project-index__detail-title-panel {
    width: auto;
    right: 5.8rem;
    left: 0;
  }
  .project-index__header .project-index__detail-title {
    font-size: clamp(0.74rem, 2.94vw, 0.98rem);
  }
  .project-index__header .project-index__detail-return {
    font-size: 0.88rem;
  }
}

/* v22 overrides */
.project-index__detail-nav:has(.project-index__detail-nav-item:hover) .project-index__detail-nav-item,
.project-index__detail-nav:has(.project-index__detail-nav-item:focus-visible) .project-index__detail-nav-item {
  transform: none !important;
  opacity: 1 !important;
}

.project-index__detail-nav:has(.project-index__detail-nav-item:hover) .project-index__detail-nav-item.is-active,
.project-index__detail-nav:has(.project-index__detail-nav-item:focus-visible) .project-index__detail-nav-item.is-active {
  transform: scale(1.035) !important;
  opacity: 1 !important;
  color: rgba(242, 237, 229, 0.96) !important;
}



/* ============================================================
   FOUNDER VIEW FIT REFINEMENT
   ============================================================ */
.project-index__detail.is-founder-view .project-index__detail-content {
  top: clamp(1.1rem, 1.8vh, 1.55rem);
  row-gap: clamp(0.65rem, 0.95vh, 0.95rem);
}

.project-index__detail.is-founder-view .project-index__detail-lede {
  font-size: clamp(1.94rem, 2.72vw, 2.96rem);
  line-height: 0.96;
  max-width: 24ch;
}

.project-index__detail.is-founder-view .project-index__detail-copy {
  max-width: 80rem;
  padding-top: 0;
}

.project-index__detail.is-founder-view .project-index__detail-copy p {
  margin: 0 0 0.72rem;
  font-size: clamp(1.02rem, 1.03vw, 1.12rem);
  line-height: 1.5;
  max-width: 42rem;
}

.project-index__detail.is-founder-view .project-index__module--profiles {
  margin-top: 0.55rem;
  padding-top: 0.65rem;
}

.project-index__detail.is-founder-view .project-index__module-header {
  margin-bottom: 0.48rem;
}

.project-index__detail.is-founder-view .project-index__module-title {
  font-size: clamp(0.96rem, 1vw, 1.22rem);
}

.project-index__detail.is-founder-view .project-index__module-note {
  font-size: clamp(0.86rem, 0.85vw, 0.98rem);
  line-height: 1.28;
}

.project-index__detail.is-founder-view .project-index__profile-grid {
  gap: 1rem;
}

.project-index__detail.is-founder-view .project-index__profile-card {
  grid-template-columns: minmax(9.6rem, 11.5rem) minmax(0, 1fr);
  gap: 1rem;
  min-height: 14.1rem;
  padding: 0.98rem;
}

.project-index__detail.is-founder-view .project-index__profile-image-wrap {
  min-height: 12.2rem;
  aspect-ratio: 4 / 4.55;
}

.project-index__detail.is-founder-view .project-index__profile-meta {
  gap: 0.28rem;
}

.project-index__detail.is-founder-view .project-index__profile-role {
  font-size: clamp(0.98rem, 0.98vw, 1.06rem);
  line-height: 1.28;
}

.project-index__detail.is-founder-view .project-index__profile-bio {
  margin-top: 0.16rem;
  font-size: clamp(0.95rem, 0.94vw, 1.03rem);
  line-height: 1.4;
  max-width: 24rem;
}

.project-index__detail.is-founder-view .project-index__profile-cta {
  margin-top: 0.5rem;
  padding: 0.42rem 0.86rem 0.48rem;
  font-size: clamp(0.9rem, 0.9vw, 0.98rem);
}

@media (max-width: 1180px) {
  .project-index__detail.is-founder-view .project-index__detail-content {
    left: clamp(2.2rem, 3.6vw, 3.2rem);
    top: clamp(1.2rem, 2vh, 1.8rem);
    width: calc(100vw - clamp(4.8rem, 7vw, 6rem) - clamp(11rem, 14vw, 13rem));
    row-gap: 0.78rem;
  }

  .project-index__detail.is-founder-view .project-index__detail-lede {
    font-size: clamp(1.4rem, 1.92vw, 1.9rem);
    max-width: 26ch;
  }

  .project-index__detail.is-founder-view .project-index__detail-copy p {
    margin-bottom: 0.64rem;
    font-size: clamp(0.95rem, 0.98vw, 1.02rem);
    line-height: 1.42;
    max-width: 34rem;
  }

  .project-index__detail.is-founder-view .project-index__module {
    margin-top: 0.9rem;
    padding-top: 0.72rem;
  }

  .project-index__detail.is-founder-view .project-index__profile-card {
    grid-template-columns: minmax(8.3rem, 9.4rem) minmax(0, 1fr);
    min-height: 12.7rem;
    padding: 0.86rem;
    gap: 0.86rem;
  }

  .project-index__detail.is-founder-view .project-index__profile-image-wrap {
    min-height: 10.6rem;
  }

  .project-index__detail.is-founder-view .project-index__profile-bio {
    font-size: clamp(0.89rem, 0.93vw, 0.97rem);
    line-height: 1.34;
  }

  .project-index__detail.is-founder-view .project-index__profile-cta {
    margin-top: 0.4rem;
  }
}

@media (max-width: 820px) {
  .project-index__detail.is-founder-view .project-index__detail-content {
    left: 1rem;
    right: 1rem;
    width: auto;
  }
}

/* ============================================================
   ROADMAP COMPACT STRIP + EXPANDED POP-UP
   ============================================================ */

.project-index__detail.is-roadmap-view .project-index__detail-content {
  row-gap: clamp(0.65rem, 1vh, 0.9rem);
}

.project-index__detail.is-roadmap-view .project-index__detail-lede {
  font-size: clamp(2.21rem, 3.22vw, 3.57rem);
  line-height: 1.02;
  letter-spacing: -0.02em;
  max-width: 34rem;
}

.project-index__detail.is-roadmap-view .project-index__detail-copy {
  max-width: 74rem;
}

.project-index__detail.is-roadmap-view .project-index__detail-copy p {
  margin: 0 0 1.15rem;
  font-size: clamp(1.16rem, 1.15vw, 1.34rem);
  line-height: 1.72;
  max-width: none;
}

.project-index__roadmap-strip {
  margin-top: clamp(0.85rem, 1.4vh, 1.15rem);
  padding-top: clamp(0.85rem, 1.4vh, 1.1rem);
  border-top: 1px solid rgba(242,237,229,0.1);
}

.project-index__roadmap-line {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: clamp(0.55rem, 0.9vw, 0.75rem);
  align-items: stretch;
}

.project-index__roadmap-step {
  appearance: none;
  position: relative;
  display: grid;
  gap: 0.42rem;
  align-content: start;
  min-height: clamp(6.05rem, 7.4vw, 6.75rem);
  padding: 0.78rem 0.78rem 0.82rem;
  border: 1px solid rgba(242,237,229,0.085);
  border-radius: 1rem;
  background: linear-gradient(180deg, rgba(255,255,255,0.028), rgba(255,255,255,0.012));
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.028), 0 0.75rem 1.8rem rgba(0,0,0,0.16);
  text-align: left;
  cursor: pointer;
  transition: transform 460ms cubic-bezier(0.22,1,0.36,1), border-color 260ms ease, background 260ms ease, box-shadow 260ms ease;
}

.project-index__roadmap-step::after {
  content: "";
  position: absolute;
  top: 1.12rem;
  left: calc(100% - 0.1rem);
  width: calc(100% - 1.15rem);
  height: 1px;
  background: linear-gradient(90deg, rgba(242,237,229,0.2), rgba(242,237,229,0.03));
  pointer-events: none;
}

.project-index__roadmap-step:last-child::after {
  display: none;
}

.project-index__roadmap-step:hover,
.project-index__roadmap-step:focus-visible {
  outline: none;
  transform: translateY(-2px);
  border-color: rgba(242,237,229,0.16);
  background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.014));
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 0.95rem 2rem rgba(0,0,0,0.19);
}

.project-index__roadmap-step-index {
  width: 2.2rem;
  height: 1.54rem;
  border-radius: 999px;
  display: inline-grid;
  place-items: center;
  border: 1px solid rgba(242,237,229,0.14);
  color: rgba(242,237,229,0.92);
  font-family: "Cormorant Garamond", serif;
  font-size: 1rem;
  line-height: 1;
  background: radial-gradient(circle at 50% 35%, rgba(255,255,255,0.08), rgba(255,255,255,0.025));
  box-shadow: 0 0 0 0.2rem rgba(242,237,229,0.02);
}

.project-index__roadmap-step-title {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(0.98rem, 1.02vw, 1.12rem);
  line-height: 1.04;
  color: rgba(242,237,229,0.94);
}

.project-index__roadmap-step-caption {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(0.78rem, 0.82vw, 0.88rem);
  line-height: 1.24;
  color: rgba(242,237,229,0.56);
  max-width: 15ch;
}

.project-index__roadmap-hint {
  margin: 0.65rem 0 0;
  font-family: "Cormorant Garamond", serif;
  font-size: 0.95rem;
  line-height: 1.35;
  color: rgba(242,237,229,0.42);
}

.project-index__roadmap-modal {
  position: fixed;
  inset: 0;
  z-index: 40;
  opacity: 0;
  pointer-events: none;
  transition: opacity 340ms ease;
}

.project-index__roadmap-modal.is-active {
  opacity: 1;
  pointer-events: auto;
}

.project-index__roadmap-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(5,7,11,0.7);
  backdrop-filter: blur(10px);
}

.project-index__roadmap-modal-panel {
  position: absolute;
  left: 50%;
  top: 50%;
  width: min(44rem, calc(100vw - 2.4rem));
  max-height: min(82vh, 48rem);
  overflow: auto;
  padding: 1.45rem 1.45rem 1.55rem;
  border: 1px solid rgba(242,237,229,0.095);
  border-radius: 1.35rem;
  background: linear-gradient(180deg, rgba(15,18,28,0.96), rgba(10,12,18,0.96));
  box-shadow: 0 1.4rem 3rem rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.03);
  transform: translate(-50%, calc(-50% + 12px));
  filter: blur(8px);
  transition: transform 520ms cubic-bezier(0.22,1,0.36,1), filter 340ms ease;
}

.project-index__roadmap-modal.is-active .project-index__roadmap-modal-panel {
  transform: translate(-50%, -50%);
  filter: blur(0);
}

.project-index__roadmap-modal-close {
  appearance: none;
  position: absolute;
  right: 1.05rem;
  top: 1rem;
  border: 0;
  background: transparent;
  color: rgba(242,237,229,0.58);
  font-family: "Cormorant Garamond", serif;
  font-size: 1rem;
  cursor: pointer;
}

.project-index__roadmap-modal-close:hover,
.project-index__roadmap-modal-close:focus-visible {
  outline: none;
  color: rgba(242,237,229,0.92);
}

.project-index__roadmap-modal-kicker {
  font-size: 0.55rem;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: rgba(242,237,229,0.28);
  margin-bottom: 0.45rem;
}

.project-index__roadmap-modal-title {
  margin: 0;
  padding-right: 4rem;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1.4rem, 2.1vw, 1.96rem);
  line-height: 0.96;
  color: rgba(242,237,229,0.96);
}

.project-index__roadmap-modal-subtitle {
  margin: 0.65rem 0 0;
  font-family: "Cormorant Garamond", serif;
  font-size: 1.18rem;
  line-height: 1.35;
  color: rgba(242,237,229,0.7);
}

.project-index__roadmap-modal-copy {
  margin-top: 1rem;
}

.project-index__roadmap-modal-copy p {
  margin: 0 0 0.95rem;
  font-family: "Cormorant Garamond", serif;
  font-size: 1.18rem;
  line-height: 1.68;
  color: rgba(242,237,229,0.78);
}

@media (max-width: 1180px) {
  .project-index__roadmap-line {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .project-index__roadmap-step:nth-child(3)::after {
    display: none;
  }
}

@media (max-width: 720px) {
  .project-index__detail.is-roadmap-view .project-index__detail-lede {
    font-size: clamp(1.7rem, 7vw, 2.35rem);
  }

  .project-index__roadmap-line {
    grid-template-columns: 1fr;
    gap: 0.72rem;
  }

  .project-index__roadmap-step {
    min-height: 0;
  }

  .project-index__roadmap-step::after {
    display: none;
  }

  .project-index__roadmap-step-caption {
    max-width: none;
  }

  .project-index__roadmap-modal-panel {
    width: min(42rem, calc(100vw - 1.2rem));
    padding: 1.1rem 1rem 1.15rem;
  }
}


/* ============================================================
   ROADMAP TIMELINE REFINEMENT — TRUE TIMELINE LOOK
   ============================================================ */

.project-index__roadmap-strip {
  margin-top: clamp(1rem, 1.5vh, 1.25rem);
  padding-top: clamp(1rem, 1.55vh, 1.2rem);
}

.project-index__roadmap-line {
  position: relative;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  column-gap: clamp(0.8rem, 1vw, 1.2rem);
  row-gap: 0;
  align-items: start;
  padding-top: 0.15rem;
}

.project-index__roadmap-track {
  position: absolute;
  left: 10%;
  right: 10%;
  top: 1.55rem;
  height: 1px;
  background: linear-gradient(90deg, rgba(242,237,229,0.10), rgba(242,237,229,0.24) 18%, rgba(242,237,229,0.24) 82%, rgba(242,237,229,0.10));
  pointer-events: none;
}

.project-index__roadmap-step {
  appearance: none;
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-rows: auto auto;
  justify-items: center;
  align-items: start;
  gap: 0.8rem;
  min-width: 0;
  padding: 0;
  background: transparent;
  border: 0;
  text-align: center;
  cursor: pointer;
  transition: transform 460ms cubic-bezier(0.22,1,0.36,1), opacity 260ms ease;
}

.project-index__roadmap-step::after {
  content: "";
  position: absolute;
  top: 2.78rem;
  width: 1px;
  height: 0.95rem;
  background: linear-gradient(180deg, rgba(242,237,229,0.18), rgba(242,237,229,0.04));
  pointer-events: none;
}

.project-index__roadmap-step:hover,
.project-index__roadmap-step:focus-visible {
  outline: none;
  transform: translateY(-2px);
}

.project-index__roadmap-step-head {
  position: relative;
  min-height: 3rem;
  display: grid;
  place-items: center;
}

.project-index__roadmap-step-index {
  width: 3rem;
  height: 3rem;
  border-radius: 999px;
  display: inline-grid;
  place-items: center;
  border: 1px solid rgba(242,237,229,0.14);
  color: rgba(242,237,229,0.94);
  font-family: "Cormorant Garamond", serif;
  font-size: 1.12rem;
  line-height: 1;
  background: radial-gradient(circle at 50% 35%, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
  box-shadow: 0 0 0 0.28rem rgba(242,237,229,0.022), 0 0.8rem 1.6rem rgba(0,0,0,0.18);
  transition: border-color 260ms ease, box-shadow 260ms ease, background 260ms ease;
}

.project-index__roadmap-step:hover .project-index__roadmap-step-index,
.project-index__roadmap-step:focus-visible .project-index__roadmap-step-index {
  border-color: rgba(242,237,229,0.24);
  box-shadow: 0 0 0 0.32rem rgba(242,237,229,0.032), 0 1rem 1.8rem rgba(0,0,0,0.2);
  background: radial-gradient(circle at 50% 35%, rgba(255,255,255,0.11), rgba(255,255,255,0.03));
}

.project-index__roadmap-step-body {
  display: grid;
  justify-items: center;
  align-content: start;
  gap: 0.34rem;
  min-width: 0;
  max-width: 12.5rem;
}

.project-index__roadmap-step-title {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(0.74rem, 0.74vw, 0.85rem);
  line-height: 1.05;
  color: rgba(242,237,229,0.95);
  text-wrap: balance;
}

.project-index__roadmap-step-caption {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(0.86rem, 0.88vw, 0.98rem);
  line-height: 1.24;
  color: rgba(242,237,229,0.58);
  max-width: 15ch;
  text-wrap: balance;
}

.project-index__roadmap-hint {
  margin: 1rem 0 0;
  font-family: "Cormorant Garamond", serif;
  font-size: 1rem;
  line-height: 1.35;
  color: rgba(242,237,229,0.42);
}

@media (max-width: 1180px) {
  .project-index__roadmap-line {
    grid-template-columns: repeat(5, minmax(8.5rem, 1fr));
    overflow-x: auto;
    padding-bottom: 0.2rem;
    scrollbar-width: thin;
  }

  .project-index__roadmap-track {
    left: 8.5%;
    right: 8.5%;
  }
}

@media (max-width: 720px) {
  .project-index__roadmap-line {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    overflow: visible;
  }

  .project-index__roadmap-track {
    display: none;
  }

  .project-index__roadmap-step {
    grid-template-columns: auto 1fr;
    grid-template-rows: auto;
    justify-items: start;
    align-items: start;
    gap: 0.9rem;
    text-align: left;
  }

  .project-index__roadmap-step::after {
    display: none;
  }

  .project-index__roadmap-step-body {
    justify-items: start;
    max-width: none;
  }

  .project-index__roadmap-step-caption {
    max-width: none;
  }
}

/* ============================================================
   ROADMAP TIMELINE REFINEMENT — V53 RESTORE, NO LINE
   ============================================================ */

.project-index__roadmap-track {
  display: none;
}

.project-index__roadmap-step::after {
  display: none;
}

.project-index__roadmap-step-body {
  width: 100%;
  max-width: none;
  min-height: 8.2rem;
  padding: 1.15rem 1rem 1.05rem;
  border-radius: 1.35rem;
  border: 1px solid rgba(242,237,229,0.08);
  background: linear-gradient(180deg, rgba(255,255,255,0.018), rgba(255,255,255,0.01));
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.025), 0 0.7rem 1.6rem rgba(0,0,0,0.08);
  transition:
    background 280ms ease,
    border-color 280ms ease,
    box-shadow 280ms ease,
    transform 460ms cubic-bezier(0.22,1,0.36,1);
}

.project-index__roadmap-step:hover .project-index__roadmap-step-body,
.project-index__roadmap-step:focus-visible .project-index__roadmap-step-body {
  border-color: rgba(242,237,229,0.15);
  background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.015));
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.035), 0 0.95rem 1.9rem rgba(0,0,0,0.12);
}

.project-index__roadmap-step-head {
  min-height: 3.35rem;
}

.project-index__roadmap-step-index {
  margin-top: 0.15rem;
}

@media (max-width: 720px) {
  .project-index__roadmap-step-body {
    min-height: auto;
    padding: 0.95rem 0.95rem 0.9rem;
  }
}


/* ============================================================
   ROADMAP TIMELINE REFINEMENT — SINGLE HOVER FRAME
   ============================================================ */

.project-index__roadmap-step {
  padding: 0.8rem 0.75rem 0.95rem;
  border-radius: 1.5rem;
  overflow: visible;
}

.project-index__roadmap-step::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 1.5rem;
  border: 1px solid rgba(242,237,229,0.10);
  background: linear-gradient(180deg, rgba(255,255,255,0.022), rgba(255,255,255,0.012));
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 0.8rem 1.7rem rgba(0,0,0,0.10);
  opacity: 0;
  transition: opacity 280ms ease, border-color 280ms ease, box-shadow 280ms ease, background 280ms ease;
  pointer-events: none;
  z-index: 0;
}

.project-index__roadmap-step > * {
  position: relative;
  z-index: 1;
}

.project-index__roadmap-step-body {
  width: 100%;
  max-width: none;
  min-height: 7.7rem;
  padding: 0;
  border-radius: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.project-index__roadmap-step:hover .project-index__roadmap-step-body,
.project-index__roadmap-step:focus-visible .project-index__roadmap-step-body {
  border: 0;
  background: transparent;
  box-shadow: none;
}

.project-index__roadmap-step:hover::before,
.project-index__roadmap-step:focus-visible::before {
  opacity: 1;
  border-color: rgba(242,237,229,0.14);
  background: linear-gradient(180deg, rgba(255,255,255,0.032), rgba(255,255,255,0.014));
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 1rem 2rem rgba(0,0,0,0.12);
}

.project-index__roadmap-step-head {
  min-height: 3.25rem;
  margin-bottom: 0.55rem;
}

.project-index__roadmap-step-index {
  margin-top: 0;
}

@media (max-width: 720px) {
  .project-index__roadmap-step {
    padding: 0.85rem 0.9rem;
  }

  .project-index__roadmap-step-body {
    min-height: auto;
  }

  .project-index__roadmap-step-head {
    margin-bottom: 0;
  }
}


.project-index__profile-modal {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: grid;
  place-items: center;
  padding: 1.2rem;
  opacity: 0;
  pointer-events: none;
  transition: opacity 340ms ease;
}
.project-index__profile-modal.is-active {
  opacity: 1;
  pointer-events: auto;
}
.project-index__profile-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(4, 6, 10, 0.76);
  backdrop-filter: blur(10px);
}
.project-index__profile-modal-panel {
  position: relative;
  z-index: 1;
  width: min(68rem, calc(100vw - 2rem));
  display: grid;
  grid-template-columns: minmax(15rem, 19rem) minmax(0, 1fr);
  gap: 1.4rem;
  padding: 1.35rem;
  border: 1px solid rgba(242, 237, 229, 0.1);
  border-radius: 1.4rem;
  background: linear-gradient(180deg, rgba(14, 18, 28, 0.96), rgba(9, 11, 18, 0.98));
  box-shadow: 0 1.7rem 4rem rgba(0,0,0,0.36), inset 0 1px 0 rgba(255,255,255,0.04);
  transform: translateY(14px) scale(0.985);
  transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
}
.project-index__profile-modal.is-active .project-index__profile-modal-panel {
  transform: translateY(0) scale(1);
}
.project-index__profile-modal-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  appearance: none;
  border: 1px solid rgba(242, 237, 229, 0.1);
  border-radius: 999px;
  background: rgba(255,255,255,0.03);
  color: rgba(242, 237, 229, 0.78);
  font-family: "Cormorant Garamond", serif;
  font-size: 0.98rem;
  letter-spacing: 0.01em;
  padding: 0.48rem 0.9rem 0.56rem;
  cursor: pointer;
  transition: border-color 220ms ease, color 220ms ease, background 220ms ease;
}
.project-index__profile-modal-close:hover,
.project-index__profile-modal-close:focus-visible {
  border-color: rgba(242, 237, 229, 0.22);
  color: rgba(242, 237, 229, 0.95);
  background: rgba(255,255,255,0.05);
}
.project-index__profile-modal-media {
  overflow: hidden;
  border-radius: 1.08rem;
  background: rgba(255,255,255,0.02);
  min-height: 24rem;
}
.project-index__profile-modal-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.project-index__profile-modal-content {
  display: grid;
  align-content: start;
  gap: 0.3rem;
  padding: 1.2rem 0.2rem 0.2rem;
}
.project-index__profile-modal-kicker {
  font-family: "Cinzel", serif;
  font-size: 0.68rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(242, 237, 229, 0.42);
}
.project-index__profile-modal-name {
  margin: 0;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1.4rem, 2.45vw, 2.1rem);
  line-height: 0.98;
  color: rgba(242, 237, 229, 0.95);
}
.project-index__profile-modal-role {
  margin: 0.05rem 0 0.45rem;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1.05rem, 1.1vw, 1.2rem);
  line-height: 1.4;
  color: rgba(242, 237, 229, 0.62);
}
.project-index__profile-modal-copy {
  display: grid;
  gap: 0.9rem;
  max-width: 35rem;
}
.project-index__profile-modal-copy p {
  margin: 0;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1.04rem, 1.05vw, 1.16rem);
  line-height: 1.62;
  color: rgba(242, 237, 229, 0.76);
}
@media (max-width: 860px) {
  .project-index__profile-modal-panel {
    grid-template-columns: 1fr;
    width: min(36rem, calc(100vw - 1.3rem));
    padding: 1rem;
  }
  .project-index__profile-modal-media {
    min-height: 15rem;
    max-height: 22rem;
  }
  .project-index__profile-modal-content {
    padding: 0.3rem 0.1rem 0.1rem;
  }
  .project-index__profile-modal-close {
    top: 0.8rem;
    right: 0.8rem;
  }
}

/* ============================================================
   V58 — FOUNDER / ECONOMICS / CAPITAL MODULES
   ============================================================ */
.project-index__module {
  width: min(78rem, 100%);
  margin-top: 1.55rem;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(242, 237, 229, 0.08);
}
.project-index__module--profiles {
  margin-top: 0.9rem;
  padding-top: 0.85rem;
}
.project-index__module-header {
  display: grid;
  gap: 0.24rem;
  margin-bottom: 0.72rem;
}
.project-index__module-title {
  margin: 0;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(0.98rem, 1.05vw, 1.33rem);
  line-height: 1.08;
  color: rgba(242, 237, 229, 0.94);
}
.project-index__module-note {
  margin: 0;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(0.95rem, 0.95vw, 1.06rem);
  line-height: 1.45;
  color: rgba(242, 237, 229, 0.52);
  max-width: 60rem;
}
.project-index__profile-highlights {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.8rem;
  width: min(78rem, 100%);
  margin: 0 0 1rem;
}
.project-index__profile-highlight {
  padding: 0.8rem 0.95rem 0.88rem;
  border: 1px solid rgba(242, 237, 229, 0.08);
  border-radius: 1rem;
  background: linear-gradient(180deg, rgba(255,255,255,0.018), rgba(255,255,255,0.008));
}
.project-index__profile-highlight-label {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(0.9rem, 0.9vw, 1rem);
  line-height: 1.2;
  color: rgba(242, 237, 229, 0.5);
  margin-bottom: 0.22rem;
}
.project-index__profile-highlight-value {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1rem, 1vw, 1.12rem);
  line-height: 1.34;
  color: rgba(242, 237, 229, 0.84);
}
.project-index__profile-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.35rem;
  width: min(84rem, 100%);
}
.project-index__profile-card {
  appearance: none;
  display: grid;
  grid-template-columns: minmax(11rem, 13.5rem) minmax(0, 1fr);
  gap: 1.22rem;
  align-items: stretch;
  width: 100%;
  min-height: 18rem;
  padding: 1.2rem;
  border: 1px solid rgba(242, 237, 229, 0.08);
  border-radius: 1.22rem;
  background: linear-gradient(180deg, rgba(255,255,255,0.028), rgba(255,255,255,0.012));
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 1rem 2rem rgba(0,0,0,0.14);
  text-align: left;
  cursor: pointer;
  transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), border-color 320ms ease, box-shadow 320ms ease, background 320ms ease;
}
.project-index__profile-card:hover,
.project-index__profile-card:focus-visible {
  transform: translateY(-3px);
  border-color: rgba(242, 237, 229, 0.18);
  background: linear-gradient(180deg, rgba(255,255,255,0.038), rgba(255,255,255,0.015));
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.035), 0 1.35rem 2.5rem rgba(0,0,0,0.18);
}
.project-index__profile-image-wrap {
  aspect-ratio: 4 / 5;
  width: 100%;
  height: 100%;
  min-height: 15.5rem;
  overflow: hidden;
  border-radius: 1rem;
  background: rgba(255,255,255,0.02);
}
.project-index__profile-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.project-index__profile-meta {
  display: grid;
  align-content: start;
  gap: 0.3rem;
  padding-top: 0.08rem;
}
.project-index__module-card-title {
  margin: 0;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(0.87rem, 0.87vw, 1.13rem);
  line-height: 1.06;
  color: rgba(242, 237, 229, 0.94);
}
.project-index__profile-role {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(0.96rem, 0.96vw, 1.06rem);
  line-height: 1.35;
  color: rgba(242, 237, 229, 0.62);
}
.project-index__profile-bio {
  margin: 0.24rem 0 0;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1rem, 0.98vw, 1.12rem);
  line-height: 1.44;
  color: rgba(242, 237, 229, 0.72);
  max-width: 30rem;
}
.project-index__profile-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  margin-top: 0.72rem;
  padding: 0.48rem 0.92rem 0.56rem;
  border: 1px solid rgba(242, 237, 229, 0.12);
  border-radius: 999px;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(0.96rem, 0.94vw, 1.04rem);
  line-height: 1;
  color: rgba(242, 237, 229, 0.84);
  background: rgba(255,255,255,0.03);
}
.project-index__kv-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.85rem 1rem;
  width: min(70rem, 100%);
}
.project-index__kv-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 0.75rem;
  padding: 0.9rem 1rem 0.95rem;
  border: 1px solid rgba(242, 237, 229, 0.08);
  border-radius: 1rem;
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.008));
}
.project-index__kv-label {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1rem, 0.98vw, 1.12rem);
  line-height: 1.32;
  color: rgba(242, 237, 229, 0.68);
}
.project-index__kv-value {
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1.05rem, 1.05vw, 1.2rem);
  line-height: 1.2;
  color: rgba(242, 237, 229, 0.94);
  text-align: right;
}
.project-index__kv-value strong {
  font-weight: 700;
  letter-spacing: 0.02em;
}
.project-index__checklist {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 0.65rem;
  width: min(70rem, 100%);
}
.project-index__check-item {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 0.7rem;
  align-items: start;
  padding: 0.8rem 1rem 0.85rem;
  border: 1px solid rgba(242, 237, 229, 0.08);
  border-radius: 1rem;
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.008));
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(1rem, 0.98vw, 1.12rem);
  line-height: 1.46;
  color: rgba(242, 237, 229, 0.78);
}
.project-index__check-mark {
  color: rgba(242, 237, 229, 0.42);
}
@media (max-width: 1180px) {
  .project-index__profile-highlights,
  .project-index__profile-grid,
  .project-index__kv-grid,
  .project-index__checklist {
    width: min(60rem, 100%);
  }
}
@media (max-width: 820px) {
  .project-index__profile-highlights,
  .project-index__profile-grid,
  .project-index__kv-grid {
    grid-template-columns: 1fr;
  }
  .project-index__profile-card {
    grid-template-columns: minmax(9rem, 10.5rem) minmax(0, 1fr);
    min-height: 15rem;
  }
  .project-index__module {
    margin-top: 1.2rem;
    padding-top: 1rem;
  }
}
@media (max-width: 560px) {
  .project-index__profile-card {
    grid-template-columns: 1fr;
    min-height: unset;
  }
  .project-index__profile-image-wrap {
    aspect-ratio: 4 / 4.8;
    min-height: 13rem;
    max-width: none;
  }
  .project-index__kv-row {
    grid-template-columns: 1fr;
    text-align: left;
  }
  .project-index__kv-value {
    text-align: left;
  }
}
